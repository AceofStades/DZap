  "cards": [
    {
      "dot": "cyan",
      "title": "Media + Volume Routing",
      "items": [
        "HDD / SATA SSD / NVMe / USB → read-only ddrescue image",
        "LUKS / BitLocker → image first, then temporary read-only unlock",
        "ext2/3/4 · XFS · Btrfs · FAT/exFAT · NTFS → filesystem copy",
        "Damaged / unmountable / raw volume → PhotoRec carving"
      ]
    },
    {
      "dot": "emerald",
      "title": "Recovery Methods",
      "items": [
        "TestDisk /list → read-only partition analysis only",
        "Filesystem copy → preserves readable names and directories",
        "PhotoRec → signature carving; names and folders are usually lost"
      ]
    },
    {
      "dot": "amber",
      "title": "Recoverable File Coverage",
      "items": [
        "Filesystem copy → every readable regular file, regardless of extension",
        "Photos → JPG · PNG · TIFF · camera RAW families",
        "Documents + archives → PDF · Office · HTML · ZIP · 7z",
        "Audio + video → WAV · AVI · MP3 · MP4 and other built-in signatures"
      ]
    }
  ]
}

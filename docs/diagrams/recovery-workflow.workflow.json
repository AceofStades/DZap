      },
      {
        "id": "resume-image",
        "label": "Pause and resume imaging",
        "focus": ["image", "plan"],
        "note": "The ddrescue map preserves progress while both drive identities are revalidated."
      },
      {
        "id": "recover-files",
        "label": "Recover and prove",
        "focus": ["volumes", "method", "recover", "manifest"],
        "note": "Named-file recovery is preferred; raw carving remains an explicit fallback."
      },
      {
        "id": "file-coverage",
        "label": "Recoverable file types",
        "focus": ["method", "recover", "manifest"],
        "note": "Filesystem copy keeps any readable regular file; PhotoRec carves every signature family enabled by the packaged build."
      }

      },
      {
        "id": "authorization",
        "label": "Identity-bound authorization",
        "focus": ["preflight", "method", "authorize"],
        "note": "The operator can authorize only the exact identity returned by fresh preflight."
      },
      {
        "id": "destruction",
        "label": "Sanitize and verify",
        "focus": ["authorize", "sanitize", "verify"],
        "note": "Command completion cannot become success until method-specific verification passes."
      },
      {
        "id": "evidence",
        "label": "Durable evidence",
        "focus": ["verify", "record", "certificate"],
        "note": "Hash-chained evidence and signed certificates are exported as one validated bundle."
      }
    ]
  },
  "lanes": [
    {"id": "operator", "label": "Operator + evidence"},

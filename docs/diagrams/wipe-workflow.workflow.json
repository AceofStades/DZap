  "cards": [
    {
      "dot": "cyan",
      "title": "Device → Available Methods",
      "items": [
        "HDD → 1-pass zero or 3-pass pattern overwrite",
        "USB / unknown → 2-pass complement overwrite",
        "SATA SSD → advertised ATA Enhanced / Secure Erase; 1-pass fallback",
        "NVMe → advertised Crypto / Block / Overwrite Sanitize; Format; 1-pass fallback"
      ]
    },
    {
      "dot": "amber",
      "title": "Method → Verification",
      "items": [
        "Host overwrite → full final-pattern readback",
        "ATA erase → security status plus sampled readback",
        "NVMe Format / Sanitize → controller status plus sampled readback"
      ]
    },
    {
      "dot": "rose",
      "title": "False Success Is Blocked",
      "items": [
        "A successful storage command is still unverified",
        "A failed check, command, or proof ends without a certificate"
      ]
    }
  ]

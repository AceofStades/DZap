    {"id": "execute", "label": "Execute + prove", "fromCol": 3, "toCol": 4, "variant": "security"},
    {"id": "publish", "label": "Record + export", "fromCol": 5, "toCol": 5, "variant": "emphasis"}
  ],
  "mainPath": ["select", "preflight", "method", "authorize", "sanitize", "verify", "record", "certificate"],
  "nodes": [
    {"id": "select", "lane": "operator", "col": 0, "type": "frontend", "label": "Select Drive", "sublabel": "model + serial"},
    {"id": "preflight", "lane": "system", "col": 0, "type": "security", "label": "Classify + Preflight", "sublabel": "HDD · SATA SSD · NVMe · USB", "tag": "read-only", "width": 146},
    {"id": "method", "lane": "operator", "col": 1, "type": "frontend", "label": "Choose Method", "sublabel": "compatible choices only", "width": 128},
    {"id": "authorize", "lane": "system", "col": 2, "type": "security", "label": "Bind Identity", "sublabel": "fresh identity", "tag": "fail closed"},
    {"id": "sanitize", "lane": "system", "col": 3, "type": "backend", "label": "Sanitize", "sublabel": "overwrite or firmware", "width": 120},
    {"id": "verify", "lane": "system", "col": 4, "type": "security", "label": "Verify Result", "sublabel": "method-specific proof", "width": 132},
    {"id": "record", "lane": "system", "col": 5, "type": "database", "label": "Persist Job", "sublabel": "hash chain"},
    {"id": "certificate", "lane": "operator", "col": 5, "type": "security", "label": "Sign + Export", "sublabel": "atomic verified bundle", "width": 124}

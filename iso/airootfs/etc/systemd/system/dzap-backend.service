[Unit]
Description=DZap secure wipe backend
After=local-fs.target
Before=getty@tty1.service

[Service]
Type=simple
Environment=HOME=/root
Environment=DZAP_FRONTEND_DIR=/opt/dzap/frontend
WorkingDirectory=/opt/dzap
ExecStart=/usr/local/bin/dzap-server
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target
